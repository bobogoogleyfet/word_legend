# Generated by Cargo
/target
debug/

# Web build output, produced by build-web.sh
/dist

# Precomputed round packs. Regenerate with:
#   cargo run --release --bin export_rounds -- rounds 1000
/rounds

# Cargo.lock is deliberately tracked: this is an application, not a library, and
# the Pages workflow builds with --locked.

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# --- secrets -----------------------------------------------------------------
# NOTHING below this line may ever be committed. Cloudflare credentials live in
# `wrangler secret put` (server side) and GitHub Actions secrets (deploy side),
# never in the repository.
.env
.env.*
.dev.vars
.dev.vars.*
*.secret
secrets.json
wrangler.toml.local
.wrangler/
server/node_modules/
node_modules/
